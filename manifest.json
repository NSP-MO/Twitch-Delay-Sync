{
  "manifest_version": 3,
  "name": "Twitch Delay Sync",
  "version": "1.0.0",
  "description": "Monitors and synchronizes Twitch stream latency to keep playback delay within user-defined limits.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Twitch Delay Sync",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.twitch.tv/*",
    "https://twitch.tv/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitch.tv/*",
        "https://twitch.tv/*"
      ],
      "js": [
        "content/isolated.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.twitch.tv/*",
        "https://twitch.tv/*"
      ],
      "js": [
        "content/main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
